#!/usr/bin/env python3
"""switcher — palette de projets (rofi) + `cd` rapide (fzf).

Usage:
    switcher [rofi]        ouvre la palette rofi
    switcher list [--tsv]  liste les projets, triés par fréquence d'usage
    switcher list --aliases  liste les noms d'alias
    switcher alias NAME    affiche le chemin de l'alias NAME
    switcher touch PATH    enregistre une ouverture de PATH
    switcher config        affiche le chemin de la config (la crée si besoin)
"""

import json
import os
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", "~/.config")).expanduser() / "switcher" / "config.toml"
HISTORY = Path(os.environ.get("XDG_DATA_HOME", "~/.local/share")).expanduser() / "switcher" / "history.json"

# Raccourcis rofi par défaut qui entrent en conflit avec les touches d'action usuelles.
ROFI_DEFAULT_BINDINGS = {
    "kb-accept-entry": "Control+j,Control+m,Return,KP_Enter",
    "kb-accept-custom": "Control+Return",
    "kb-accept-custom-alt": "Control+Shift+Return",
    "kb-accept-alt": "Shift+Return",
}


# --- config -----------------------------------------------------------------

def load_config():
    if not CONFIG.exists():
        CONFIG.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(HERE / "config.example.toml", CONFIG)
    with CONFIG.open("rb") as f:
        cfg = tomllib.load(f)
    cfg.setdefault("root", [])
    cfg.setdefault("markers", [".git"])
    cfg.setdefault("exclude", [])
    cfg.setdefault("aliases", {})
    cfg.setdefault("action", [])
    return cfg


# --- scan -------------------------------------------------------------------

def scan(cfg):
    """Retourne {chemin absolu: libellé} pour chaque projet trouvé."""
    markers = set(cfg["markers"])
    exclude = set(cfg["exclude"])
    found = {}

    def walk(base, rel, depth, max_depth):
        try:
            entries = sorted(os.scandir(base), key=lambda e: e.name.lower())
        except OSError:
            return
        for e in entries:
            if e.name.startswith(".") or e.name in exclude or not e.is_dir():
                continue
            label = f"{rel}/{e.name}" if rel else e.name
            found.setdefault(e.path, label)
            if depth < max_depth and not is_project(e.path, markers):
                walk(e.path, label, depth + 1, max_depth)

    for root in cfg["root"]:
        path = os.path.expanduser(root["path"])
        walk(path, "", 1, root.get("depth", 2))
    return found


def is_project(path, markers):
    return any(os.path.exists(os.path.join(path, m)) for m in markers)


# --- historique (frecency) --------------------------------------------------

def load_history():
    try:
        return json.loads(HISTORY.read_text())
    except (OSError, ValueError):
        return {}


def touch(path):
    path = os.path.realpath(os.path.expanduser(path))
    hist = load_history()
    entry = hist.setdefault(path, {"count": 0, "last": 0})
    entry["count"] += 1
    entry["last"] = time.time()
    HISTORY.parent.mkdir(parents=True, exist_ok=True)
    tmp = HISTORY.with_suffix(".tmp")
    tmp.write_text(json.dumps(hist, indent=1))
    tmp.replace(HISTORY)


def frecency(entry, now):
    """Score à la zoxide : nombre d'ouvertures pondéré par la récence."""
    age = now - entry["last"]
    if age < 3600:
        weight = 4
    elif age < 86400:
        weight = 2
    elif age < 7 * 86400:
        weight = 0.5
    else:
        weight = 0.25
    return entry["count"] * weight


# --- liste ------------------------------------------------------------------

def entries(cfg):
    """Liste de (libellé, chemin), les plus utilisés d'abord."""
    projects = scan(cfg)

    by_path = {}
    for name, target in cfg["aliases"].items():
        target = os.path.expanduser(target)
        by_path.setdefault(target, []).append(name)
        projects.setdefault(target, target.replace(str(Path.home()), "~", 1))
    for path, names in by_path.items():
        projects[path] += "  (" + ", ".join(names) + ")"

    hist = load_history()
    now = time.time()

    def key(item):
        path, label = item
        h = hist.get(os.path.realpath(path))
        return (-frecency(h, now) if h else 0, label.lower())

    return [(label, path) for path, label in sorted(projects.items(), key=key)]


# --- rofi -------------------------------------------------------------------

def rofi(cfg):
    items = entries(cfg)
    actions = cfg["action"]
    if not actions:
        sys.exit("switcher: aucune action définie dans " + str(CONFIG))

    args = ["rofi", "-dmenu", "-i", "-p", "projet", "-format", "i",
            "-no-custom", "-matching", "fuzzy"]

    # Action 0 = Entrée (kb-accept-entry), les suivantes = kb-custom-N (code de sortie 9+N).
    # Les touches utilisées par les actions sont retirées des raccourcis par défaut.
    used = {k for a in actions for k in a["key"].split(",")}
    bindings = {name: ",".join(k for k in keys.split(",") if k not in used)
                for name, keys in ROFI_DEFAULT_BINDINGS.items()}
    bindings["kb-accept-entry"] = ",".join(filter(None, [actions[0]["key"], bindings["kb-accept-entry"]]))
    for n, action in enumerate(actions[1:], start=1):
        bindings[f"kb-custom-{n}"] = action["key"]
    for name, keys in bindings.items():
        args += ["-" + name, keys]

    mesg = "   ".join(f"<b>{pretty_key(a['key'])}</b> {a['name']}" for a in actions)
    args += ["-mesg", mesg]

    proc = subprocess.run(args, input="\n".join(label for label, _ in items),
                          capture_output=True, text=True)
    if proc.returncode == 0:
        action = actions[0]
    elif 10 <= proc.returncode < 9 + len(actions):
        action = actions[proc.returncode - 9]
    else:
        return  # Échap ou erreur
    if not proc.stdout.strip():
        return

    path = items[int(proc.stdout.strip())][1]
    touch(path)
    cmd = [part.replace("{path}", path) for part in action["cmd"]]
    subprocess.Popen(cmd, cwd=path, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def pretty_key(key):
    return key.split(",")[0].replace("Control", "Ctrl").replace("Return", "Entrée")


# --- main -------------------------------------------------------------------

def main(argv):
    cmd = argv[0] if argv else "rofi"
    cfg = load_config()

    if cmd == "rofi":
        rofi(cfg)
    elif cmd == "list" and "--aliases" in argv:
        print("\n".join(cfg["aliases"]))
    elif cmd == "list":
        tsv = "--tsv" in argv
        for label, path in entries(cfg):
            print(f"{label}\t{path}" if tsv else label)
    elif cmd == "alias" and len(argv) == 2:
        target = cfg["aliases"].get(argv[1])
        if not target:
            return 1
        print(os.path.expanduser(target))
    elif cmd == "touch" and len(argv) == 2:
        touch(argv[1])
    elif cmd == "config":
        print(CONFIG)
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
